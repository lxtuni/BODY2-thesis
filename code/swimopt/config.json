{
  // ==========================================================================
  //  swimopt 配置文件 —— 所有能调的东西都在这里
  //  说明: 本文件支持 // 注释 (由 load_cfg 自动去除), 直接用记事本改即可
  // ==========================================================================

  // ┌────────────────────────────────────────────────────────────────────────┐
  // │ 1. 用哪个模型  ← 换机器人只需要改这一行                                 │
  // └────────────────────────────────────────────────────────────────────────┘
  "model": "robots/body2_fluke.xml",     // 当前模型: body2_fluke.xml
  // "model": "robots/body2.xml",     // ← 你的 BODY2 精确模型(用 import_model.py 转出来的)

  // ┌────────────────────────────────────────────────────────────────────────┐
  // │ 2. 仿真设置  ← 想跑快点就调这两个                                       │
  // └────────────────────────────────────────────────────────────────────────┘
  "timestep":     0.002,   // 物理步长(秒). 0.002稳/慢, 0.004快一倍(闭环模型建议 ≤0.002)
  "sim_time":     8.0,     // 每次评估跑多少秒仿真. 越短越快, 但太短测不准稳态速度
  "settle_time":  1.0,     // 开始前静置几秒(等浮起来稳定), 不计入成绩
  "trunk_body":   "trunk",  // 机身刚体(自动识别)
  "vmax_guard":   5.0,     // 防爆护栏: 速度超过这个值判定发散, 直接给最低分并中止

  // ┌────────────────────────────────────────────────────────────────────────┐
  // │ 3. 优化目标  ← 决定"什么叫游得好"                                       │
  // │    fitness = 前进速度 − w_yaw×偏航率 − w_energy×能耗                    │
  // └────────────────────────────────────────────────────────────────────────┘
  "w_yaw":    0.3,   // 偏航惩罚: 0=不管转弯只要快; 0.3=要求走直; 1.0=非常严格
  "w_energy": 0.0,   // 能耗惩罚: 0=只看速度; 0.01~0.1=兼顾省电(做"运输代价"最优时用)

  // ┌────────────────────────────────────────────────────────────────────────┐
  // │ 4. 搜索预算  ← 跑多少次、多大种群                                       │
  // └────────────────────────────────────────────────────────────────────────┘
  "budget":  250,      // 总共跑多少次仿真(命令行第二个参数会覆盖它)
  "popsize": 10,       // CMA-ES 每代试几组参数. 维度高时可加到 12~16
  "sigma0":  0.25,     // 初始搜索半径(0~1空间). 0.2~0.4 常用; 太大乱撞, 太小陷局部
  "seed":    1,        // 随机种子. 换个数字=换一次独立搜索(可用于验证结果稳定性)
  "outdir":  "results",

  // ┌────────────────────────────────────────────────────────────────────────┐
  // │ 5. 水动力  ← 标定实验做完后, 把系数填到这里                             │
  // │    每个连杆受力 F = 浮力 ρgV·f + 阻力 ½ρ·Cd·A·v|v|·f + 粘性 cv·v·f      │
  // │    f = 浸没比例(自动按几何算), Ca = 附加质量系数                        │
  // └────────────────────────────────────────────────────────────────────────┘
  "hydro": {
    "rho":     1000.0,   // 水密度 kg/m³
    "water_z": 0.0,      // 水面高度(世界坐标 z). 机器人应放在水面附近
    "exclude": ["vis_"], // 名字含这些词的 geom 不参与水动力(纯装饰件)

    // 没匹配到下面任何规则时用这套系数
    "default": { "cd": [0.3, 0.3, 0.3], "ca": 0.2, "cv": 0.02 },

    // 规则按顺序匹配 geom 名字里的关键字, 命中即停
    //   cd = [x,y,z] 三个局部轴的阻力系数(桨面法向要大, 薄边要小 → 这是推力的来源)
    //   ca = 附加质量系数(平板≈1.0, 细杆≈0.3, 机身≈0.2)
    //   cv = 线性粘性系数(低速阻尼)
    "rules": [
      { "match": "flip",  "cd": [2.2, 0.10, 0.10], "ca": 1.0, "cv": 0.05 },  // 脚蹼/桨
      { "match": "link",  "cd": [0.5, 0.50, 0.25], "ca": 0.3, "cv": 0.02 },  // 腿杆
      { "match": "trunk", "cd": [0.9, 1.60, 1.80], "ca": 0.2, "cv": 0.10 }   // 机身
      // 用 BODY2 模型时改成(按连杆编号匹配):
      // { "match": "2.4",  "cd": [2.2, 0.10, 0.10], "ca": 1.0, "cv": 0.05 },  // 脚蹼
      // { "match": "2.",   "cd": [0.5, 0.50, 0.25], "ca": 0.3, "cv": 0.02 },  // 下连杆组
      // { "match": "1.",   "cd": [0.5, 0.50, 0.25], "ca": 0.3, "cv": 0.02 },  // 上连杆组
      // { "match": "base", "cd": [0.9, 1.60, 1.80], "ca": 0.2, "cv": 0.10 }   // 机身
    ]
  },

  // ┌────────────────────────────────────────────────────────────────────────┐
  // │ 6. 步态参数化  ← 决定搜索空间有多大                                     │
  // │    每个电机: 角度 = 偏置 + Σ 幅度h·sin(2π·h·f·t + 相位h)                │
  // │    维度 = 1(频率) + H×(幅度组数 + 电机数) + 偏置组数                    │
  // └────────────────────────────────────────────────────────────────────────┘
  "gait": {
    "harmonics":    2,           // 谐波数. 2=可表达"整流顺桨"(主动脚蹼必需); 脚蹼被动时可设1
    "duty_range":   [0.25, 0.75],// 发力相占空比范围(划水狗论文比较了25%/33%/50%: 快划慢收vs慢划快收)
    "freq_range":   [0.2, 2.5],  // 划水频率搜索范围 Hz (受真机舵机速度限制, 别设太高)
    "amp_range":    [0.0, 0.9],  // 关节摆幅范围 rad
    "offset_range": [-0.5, 0.5], // 关节中位角范围 rad (决定腿伸展的基准姿态)
    "amp2_scale":   1.0,         // 二次谐波幅度上限的缩放(想让它小一点可设 0.5)
    "ramp_t":       1.5,         // 起步渐入时间(秒), 避免开局猛甩

    // 分组: 名字含 match 的电机共享 amp/offset → 降维. 相位始终每个电机独立
    "groups": [
      { "match": "1.1", "share": ["amp", "offset"] },   // 所有腿的上关节共享幅度
      { "match": "2.1", "share": ["amp", "offset"] },   // 所有腿的下关节共享幅度
      { "match": "3.1", "share": ["amp", "offset"] }    // 所有腿的脚蹼共享幅度
    ]
  }
}
