        ]
        boundingObject Box { size 0.012 0.012 0.05 }
        physics Physics { density -1 mass 0.012 }
        immersionProperties [
          ImmersionProperties {
            fluidName "water"
            referenceArea "xyz-projected area"
            dragForceCoefficients 0.40 0.40 0.20
            dragTorqueCoefficients 0 0 0
            viscousResistanceForceCoefficient 0.15
            viscousResistanceTorqueCoefficient 0.08
          }
        ]
      }
    }
  ]
  boundingObject Box { size 0.220 0.100 0.050 }
  physics Physics { density -1 mass 0.200 }
  immersionProperties [
    ImmersionProperties {
      fluidName "water"
      referenceArea "xyz-projected area"
      dragForceCoefficients 0.80 0.80 0.90
      dragTorqueCoefficients 0 0 0
      viscousResistanceForceCoefficient 0.40
      viscousResistanceTorqueCoefficient 0.40
    }
  ]
