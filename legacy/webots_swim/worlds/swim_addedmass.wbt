      device [
        RotationalMotor { name "RL_hip" maxTorque 0.20 maxVelocity 4 }
        PositionSensor { name "RL_hip_sensor" }
      ]
      endPoint Solid {
        translation -0.0900 0.0580 -0.0250
        name "RL_thigh"
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.85 0.55 0.15 roughness 1 metalness 0 }
            geometry Box { size 0.012 0.012 0.05 }
          }
          HingeJoint {
            jointParameters HingeJointParameters { axis 0 1 0  anchor 0 0 -0.0250 }
