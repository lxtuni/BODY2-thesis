        name "RR_thigh"
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.85 0.55 0.15 roughness 1 metalness 0 }
            geometry Box { size 0.012 0.012 0.05 }
          }
          HingeJoint {
            jointParameters HingeJointParameters { axis 0 1 0  anchor 0 0 -0.0250 }
            device [
              RotationalMotor { name "RR_wrist" maxTorque 0.20 maxVelocity 4 }
              PositionSensor { name "RR_wrist_sensor" }
            ]
            endPoint DEF RR_PADDLE Solid {
